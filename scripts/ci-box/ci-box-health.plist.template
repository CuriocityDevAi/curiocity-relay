<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd plist 템플릿 — ci-box heartbeat (M1-1126-C)
  설치: install-health.sh 가 HOME / SCRIPT_DIR 를 치환 후
        ~/Library/LaunchAgents/dev.curiocity.ci-box-health.plist 에 배치
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.curiocity.ci-box-health</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SCRIPT_DIR__/health.sh</string>
    </array>

    <!-- 5분(300초) 간격 -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- launchd 등록 직후 한 번 즉시 실행 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 종료 코드와 무관하게 재실행 안전 (launchd 가 관리) -->
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/ci-box-health.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/ci-box-health.log</string>

    <!-- 환경 변수: PATH 에 Homebrew 포함 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>
</dict>
</plist>
