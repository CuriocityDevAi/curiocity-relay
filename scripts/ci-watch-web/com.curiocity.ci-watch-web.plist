<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.curiocity.ci-watch-web</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>RELAY_WEB_DIR/scripts/ci-watch-web/server.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>RELAY_WEB_DIR</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>HOME_DIR/.hub-runner/ci-watch-web.log</string>

  <key>StandardErrorPath</key>
  <string>HOME_DIR/.hub-runner/ci-watch-web.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>HOME_DIR</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    <key>CI_WATCH_WEB_DIR</key>
    <string>RELAY_WEB_DIR</string>
    <key>CI_WATCH_GIT_BRANCH</key>
    <string>GIT_BRANCH_PLACEHOLDER</string>
  </dict>
</dict>
</plist>
