<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.curiocity.token-meter</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/kyu.lee/projects/curiocity-relay-tokens/scripts/token-meter/run.sh</string>
  </array>

  <!-- 30분마다 실행 -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/kyu.lee/.hub-runner/token-meter.launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/kyu.lee/.hub-runner/token-meter.launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/kyu.lee</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/kyu.lee/.local/bin</string>
  </dict>
</dict>
</plist>
